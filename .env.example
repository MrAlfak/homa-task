# Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# Google Sheet ID (from URL: https://docs.google.com/spreadsheets/d/SHEET_ID/edit)
GOOGLE_SHEET_ID=your_sheet_id_here

# Path to Google Service Account JSON credentials file
GOOGLE_CREDENTIALS_PATH=credentials/google-service-account.json

# Or paste full JSON in one line (recommended for Dokploy):
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}

# Bot mode: polling (dev) or webhook (production)
BOT_MODE=polling

# Webhook settings (only when BOT_MODE=webhook)
WEBHOOK_HOST=https://your-domain.com
WEBHOOK_PATH=/webhook
WEBHOOK_PORT=8080

# Optional: Telegram verifies this header. If empty, a stable value is derived from BOT_TOKEN.
# WEBHOOK_SECRET=

# Optional: persist FSM (create-task flow) across restarts
# FSM_PATH=/tmp/homa_fsm.json

# Optional: Telegram group id for team announcements and overdue digest (e.g. -1001234567890)
# GROUP_CHAT_ID=

# mydnspanel SMS (Personnel column موبایل + تب SMS). Leave empty to disable sending.
# SMS_API_KEY=
# SMS_API_URL=https://mydnspanel.com/webservice/server

# Re-apply sheet dropdowns on boot (default: only when columns were just added)
# FORCE_SHEET_SCHEMA=false

# Docker-only OpenVPN to MikroTik (not a user VPN). GRE/L2TP profiles are separate.
# OVPN_USER=homa-docker
# OVPN_PASSWORD=
# OVPN_CA_B64=
# OVPN_REMOTE=155.117.197.30
